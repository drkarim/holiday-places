# Bearer token required on POST/PATCH/DELETE /api/places* — pick any long random string.
API_TOKEN=change-me-to-a-long-random-string

# --- Firebase (production) ---
# From Firebase Console > Project settings > Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep the \n escapes exactly as Firebase gives them (quotes are optional).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
# Only needed if you've enabled Storage (requires the Blaze plan — see README).
# Newer projects default to <project-id>.firebasestorage.app, not .appspot.com.
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# --- Optional ---
# Path (relative to repo root) to the xlsx file to auto-import on first run.
XLSX_PATH=data/places.xlsx
PORT=3000

# Free key from https://www.pexels.com/api/ — without it, places with no
# photos of their own just show the placeholder icon instead of a category
# stock photo.
PEXELS_API_KEY=

# --- Local development only: point at the Firebase emulator instead of real Firebase ---
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# --- Client build-time config (Vite reads these when building client/) ---
VITE_API_TOKEN=change-me-to-a-long-random-string
