{
  "name": "holiday-places",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first PWA for browsing, filtering and adding holiday places of interest.",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "import": "node server/src/importer/importXlsx.js",
    "fetch-photos": "node server/src/importer/fetchPhotos.js",
    "emulators": "firebase emulators:start --only firestore,storage"
  },
  "engines": {
    "node": ">=22"
  }
}
