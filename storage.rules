rules_version = '2';

// Uploads go through the backend (Firebase Admin SDK), which bypasses these
// rules. Direct client-side access is denied; uploaded photo objects are
// served as public URLs set by the backend at upload time.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
